# Neon Postgres connection string (Vercel Storage → Neon → Connect)
DATABASE_URL=

# Password for the /admin dashboard login.
# This is the client's actual login credential, not a dev secret — it must be
# hand-delivered to the client (not committed, not posted anywhere shared) once set
# in Vercel's env vars, so they can sign in to manage their own products.
ADMIN_PASSWORD=

# Random string (32+ chars) used to encrypt the admin session cookie
SESSION_SECRET=

# Vercel Blob read/write token, for product photo uploads (Vercel Storage → Blob → Connect)
BLOB_READ_WRITE_TOKEN=
